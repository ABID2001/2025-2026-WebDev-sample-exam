function ActionAllHoFGeneric<T>(arr:Array<T>, fx:(a:T, b:T) => T):T {
  let result = arr[0];

  for(let i=1; i<arr.length; i++){
    result = fx(result, arr[i]);  
  }
  
  return result;
}

