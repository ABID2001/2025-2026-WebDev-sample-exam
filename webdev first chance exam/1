<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CSS Specificity Example</title>
    <style>
        p {
            color: blue;
        }

        #content p {
            color: red;
        }

        #highlight {
            color: green;
        }
    </style>
</head>
<body>
    <div class="wrapper" id="content">
        <p id="highlight" style="color: yellow;">Example</p>
    </div>
</body>
</html>

